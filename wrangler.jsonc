{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antimatter-site",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mazinator",
      "database_id": "2e1d077a-b29e-46d2-ac58-08ffd778f12e"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only these paths go through worker.js; everything else is served
    // straight from the static files, as before.
    "run_worker_first": ["/leapwork", "/leapwork/*", "/private/*"]
  }
}
